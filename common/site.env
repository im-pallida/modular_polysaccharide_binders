# Machine settings for the shell half of the pipeline.
#
#     source "<project>/common/site.env"
#
# There is nothing to edit here. The discovery lives in common/site_config.py, and
# this file evaluates it, so the shell scripts and the Python stages cannot
# disagree about where AlphaFold3 is.
#
# What the caller already exported always wins; after that
# common/site.local.env, which is per machine and not tracked; discovery last.
#
# Paths resolve from THIS FILE's location, so a clone under any user's home or
# scratch works untouched.

_SITE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export PIPELINE_ROOT="$(cd "$_SITE_DIR/.." && pwd)"

# python3 is usually there, but an sbatch script sources this before its
# module load, so a missing interpreter must not take the job down. Whatever
# the caller exported, and each script's own fallbacks, still apply.
if command -v python3 >/dev/null 2>&1; then
    _SITE_EXPORTS="$(python3 "$_SITE_DIR/site_config.py" --export 2>/dev/null)" \
        && eval "$_SITE_EXPORTS"
    unset _SITE_EXPORTS
else
    echo "[site] python3 not on PATH -- using the environment as given" >&2
fi

unset _SITE_DIR
