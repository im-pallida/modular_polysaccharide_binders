# Machine-specific settings for RFD3.
#
# Paths resolve from this file's own location, so a copy of the project under
# any user's home or scratch works without editing.
#
# RFD3_EXE and CKPT are discovered by common/site_config.py, which this file
# sources through common/site.env. That indirection exists for one reason: this
# file used to look only at $CONDA_PREFIX and PATH, which are set in an
# activated login shell and NOT on a compute node -- so every submitted job
# died with "RFD3_EXE and/or CKPT not set" while the same command worked by
# hand. Discovery that depends on having activated something cannot serve a
# batch job.
#
# Anything already exported still wins, and site.local.env is where to put a
# path discovery cannot work out:
#
#     RFD3_EXE=/shared/scratch/<project>/<user>/software/rfd3/envs/rfd3_venv_py312/bin/rfd3
#     CKPT=/shared/scratch/<project>/<user>/software/rfd3/checkpoints/rfd3_latest.ckpt

_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
_STAGE="$(cd "$_ENV_DIR/../.." && pwd)"
_COMMON="$(cd "$_STAGE/.." && pwd)/common"

export RFD3_ALLOW_EXACT_ASU_MOTIF=1

if [ -f "$_COMMON/site.env" ]; then . "$_COMMON/site.env"; fi

# The fallbacks site_config cannot express: an activated environment, and PATH.
# Only reached when discovery found nothing, and harmless when it did.
if [ -z "${RFD3_EXE:-}" ] || [ ! -x "${RFD3_EXE:-}" ]; then
    export RFD3_EXE="${CONDA_PREFIX:-/nonexistent}/bin/rfd3"
fi
if [ ! -x "$RFD3_EXE" ]; then export RFD3_EXE="$(command -v rfd3 || true)"; fi

if [ -z "${CKPT:-}" ] || [ ! -f "${CKPT:-}" ]; then
    export CKPT="${CKPT:-$HOME/.foundry/checkpoints/rfd3_latest.ckpt}"
fi
if [ ! -f "$CKPT" ] && [ -f "$_STAGE/checkpoints/rfd3_latest.ckpt" ]; then
    export CKPT="$_STAGE/checkpoints/rfd3_latest.ckpt"
fi

unset _ENV_DIR _STAGE _COMMON
